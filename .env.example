# Native Researcher local configuration example.
# Copy values into your shell environment or runtime/settings files as needed.

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Workspace/runtime paths
DOWNLOAD_ROOT=downloads
WORKSPACE_ROOT=workspace

# External APIs
ASSISTANT_API_KEY=
NCBI_API_KEY=
UNPAYWALL_EMAIL=
OPENALEX_API_KEY=
CORE_API_KEY=

# Search/PDF behavior
AI_PRIMARY_SEARCH_RESOURCE=pubmed
PUBMED_OA_ONLY=true
PDF_DOWNLOADER_MODE=pdf_xml
PDF_UNPAYWALL_FALLBACK_ENABLED=true
PDF_CORE_FALLBACK_ENABLED=false
PDF_ARXIV_FALLBACK_ENABLED=false

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_THINKING_LEVEL=off

# llama.cpp
LLAMACPP_BASE_URL=http://localhost:8098
LLAMACPP_MODEL=local
LLAMACPP_EXECUTABLE=
LLAMACPP_MODEL_PATH=
LLAMACPP_LIBRARY_PATH=
LLAMACPP_SERVER_ARGS=
LLAMACPP_AUTO_START=true

# Optional model discovery roots. Use ':' separated paths on Linux/macOS.
# Example: /mnt/models:/home/me/LLMs
LOCAL_LLM_MODEL_ROOTS=
LLAMACPP_MODEL_ROOTS=
